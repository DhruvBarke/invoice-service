# Applies to every module (config.stopBubbling marks this as the root).
config.stopBubbling = true

# Stamp @lombok.Generated on everything Lombok writes.
#
# JaCoCo natively skips methods carrying that annotation, which takes generated getters,
# setters, builders, equals, hashCode and toString out of the coverage numbers. Without it the
# gate is unreachable for the wrong reason: a @Data class with seven fields contributes ~300
# branches from the null-checks inside generated equals(), and "covering" them means writing
# assertions that prove Lombok works rather than that our code does.
#
# What still counts: every hand-written method, including ones that live beside Lombok
# annotations. Deleting this line does not relax the gate — it makes it impossible to meet.
lombok.addLombokGeneratedAnnotation = true
