<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.invoice</groupId>
    <artifactId>invoice-service-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Invoice Service (parent)</name>

    <!--
      NOTE ON PLACEMENT
      These modules are designed to live as SIBLINGS inside the existing invoice-service repo.
      If you are adopting them there, delete this parent pom and instead add the four <module>
      entries plus the <dependencyManagement> block below to the invoice-service parent pom.
      A standalone repo works too, but then invoice-mapper and invoice-service-app must consume
      published artifacts rather than reactor modules.
    -->

    <modules>
        <module>build-tools/readme-doclet</module>
        <module>invoice-service-domain</module>
        <module>invoice-service-cache</module>
        <module>invoice-service-alerting</module>
        <module>invoice-mapper</module>
        <module>invoice-service-app</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <spring-boot.version>3.3.4</spring-boot.version>
        <jacoco.version>0.8.12</jacoco.version>
        <mockito.version>5.14.2</mockito.version>
        <lombok.version>1.18.30</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>invoice-service-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>invoice-service-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>invoice-service-alerting</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>invoice-mapper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <!--
              Managed centrally because two modules need it: the domain (for the model classes it
              now owns) and the mapper. Two hardcoded versions drifting apart produces an
              annotation processor that runs against one Lombok and links against another, which
              surfaces as a missing generated method rather than as a version conflict.
            -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                        <compilerArgs><arg>-Xlint:all</arg></compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              COVERAGE GATE
              100% line AND branch coverage, enforced at `verify`. The build fails below that,
              which is what the PR gate needs.

              The exclusions below are data-holder classes, not logic:

                */model/**            The vendored UBL Invoice graph (63 classes) and the Flux 10
                                      ReportModel graph (34). Lombok-generated getters, setters,
                                      builders, equals/hashCode/toString. Covering them means
                                      asserting that a setter sets — it proves the Lombok version,
                                      not our code. They carry no branches of ours.

                */config/**           The Spring composition root: @Bean methods and
                                      @ConfigurationProperties holders. Exercising these means
                                      standing up a context, which tests wiring rather than
                                      behaviour. The classes those beans construct ARE covered,
                                      through their own unit tests.

                */package-info        No executable code.

              Everything else — mappers, rules, the error taxonomy, the orchestrator, the JDBC
              adapters' SQL-building, the alert body formatter — is held to the full bar.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!--
                      NOTE ON VACUOUS PASSES
                      jacoco:check is a no-op when no exec file exists, so a module with zero
                      tests would sail through the gate rather than fail it. haltOnFailure with
                      an explicit BUNDLE rule still cannot see a bundle that was never produced
                      — the protection is that every module carrying main classes also carries
                      tests. invoice-service-app is the sole exception: its whole source tree is
                      the excluded config/ package, so it legitimately has nothing to measure.
                    -->
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>**/model/**</exclude>
                        <exclude>**/config/**</exclude>
                        <exclude>**/package-info.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          README GENERATION
          Run: mvn -P readme package
          Each module writes its own README.md from its package-info.java comments. Documentation
          lives beside the code it describes, is reviewed in the same diff, and cannot drift.
        -->
        <profile>
            <id>readme</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>generate-readme</id>
                                <phase>package</phase>
                                <goals><goal>javadoc</goal></goals>
                                <configuration>
                                    <doclet>com.example.build.readme.ReadmeDoclet</doclet>
                                    <docletArtifact>
                                        <groupId>${project.groupId}</groupId>
                                        <artifactId>readme-doclet</artifactId>
                                        <version>${project.version}</version>
                                    </docletArtifact>
                                    <useStandardDocletOptions>false</useStandardDocletOptions>
                                    <additionalOptions>
                                        <additionalOption>-readmeOutput ${project.basedir}/README.md</additionalOption>
                                        <additionalOption>-readmeTitle "${project.artifactId}"</additionalOption>
                                    </additionalOptions>
                                    <!-- Custom tags must be declared or javadoc rejects them. -->
                                    <tags>
                                        <tag><name>readme.module</name><placement>a</placement><head>Module:</head></tag>
                                        <tag><name>readme.section</name><placement>a</placement><head>Section:</head></tag>
                                        <tag><name>readme.order</name><placement>a</placement><head>Order:</head></tag>
                                        <tag><name>readme.depends</name><placement>a</placement><head>Depends on:</head></tag>
                                    </tags>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
