<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sg</groupId>
    <artifactId>invoice-service-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Invoice Service (parent)</name>

    <!--
      MODULE LAYOUT

      Six modules, matching the invoice-service repo this is migrating into, so a module here
      lands on the module of the same name there rather than being unpicked first.

        domain-interface  models, ports (repository + service interfaces). No dependencies.
        domain            service implementations: the registration use case, the validation
                          rules, the party cache, quarantine and alert publishing.
        mapper            transformation only, held apart from domain for the same reason
                          e-invoicing-service holds transformation-engine apart: mapping is
                          independently testable and must not acquire orchestration.
        jpa-adapter       entities and the adapters that implement the repository ports.
        rest-adapter      controllers, as an interface plus its implementation.
        bootstrap         the Spring Boot application class and all configuration.

      Every module depends on domain-interface and, apart from bootstrap, on nothing else in
      this build. Adapters meet at ports in domain-interface, never by importing one another.
      The bannedDependencies rules in each module enforce that.
    -->

    <modules>
        <module>build-tools/readme-doclet</module>
        <module>domain-interface</module>
        <module>domain</module>
        <module>invoice-mapper</module>
        <module>alert-adapter</module>
        <module>caching-adapter</module>
        <module>third-parties</module>
        <module>jpa-adapter</module>
        <module>rest-adapter</module>
        <module>bootstrap</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <spring-boot.version>3.3.4</spring-boot.version>
        <jacoco.version>0.8.12</jacoco.version>
        <mockito.version>5.14.2</mockito.version>
        <lombok.version>1.18.30</lombok.version>
        <jackson.version>2.17.2</jackson.version>
        <spring.version>6.1.13</spring.version>
        <springdoc.version>2.6.0</springdoc.version>
        <swagger.version>2.2.22</swagger.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>domain-interface</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>invoice-mapper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>alert-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>caching-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>third-parties</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jpa-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>rest-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
              Spring and Jackson versions managed here rather than in each module. Three modules
              now take them; without this each names its own version, and the first mismatch
              surfaces as a NoSuchMethodError at runtime instead of a conflict at build time.

              Pinned artifact by artifact rather than by importing spring-boot-dependencies: the
              BOM is a separate download, and a build that cannot run offline is one more thing
              between a new checkout and a green build.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-jdbc</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-web</artifactId>
                <version>${spring.version}</version>
            </dependency>
            <!--
              Annotations only, in rest-adapter. springdoc reads them at runtime to build the
              spec; it is NOT a dependency of the modules that own the types being documented.
              domain-interface must stay at zero dependencies, so nothing there is annotated —
              springdoc introspects those classes structurally instead.
            -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <!--
              Managed centrally because two modules need it: the domain (for the model classes it
              now owns) and the mapper. Two hardcoded versions drifting apart produces an
              annotation processor that runs against one Lombok and links against another, which
              surfaces as a missing generated method rather than as a version conflict.
            -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                        <compilerArgs><arg>-Xlint:all</arg></compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              COVERAGE GATE
              100% line AND branch coverage, enforced at `verify`. The build fails below that,
              which is what the PR gate needs.

              The exclusions below are data-holder classes, not logic:

                */model/**            The vendored UBL Invoice graph (63 classes) and the Flux 10
                                      ReportModel graph (34). Lombok-generated getters, setters,
                                      builders, equals/hashCode/toString. Covering them means
                                      asserting that a setter sets — it proves the Lombok version,
                                      not our code. They carry no branches of ours.

                */config/**           The Spring composition root: @Bean methods and
                                      @ConfigurationProperties holders. Exercising these means
                                      standing up a context, which tests wiring rather than
                                      behaviour. The classes those beans construct ARE covered,
                                      through their own unit tests.

                */package-info        No executable code.

              Everything else — mappers, rules, the error taxonomy, the orchestrator, the JDBC
              adapters' SQL-building, the alert body formatter — is held to the full bar.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!--
                      NOTE ON VACUOUS PASSES
                      jacoco:check is a no-op when no exec file exists, so a module with zero
                      tests would sail through the gate rather than fail it. haltOnFailure with
                      an explicit BUNDLE rule still cannot see a bundle that was never produced
                      — the protection is that every module carrying main classes also carries
                      tests. invoice-service-app is the sole exception: its whole source tree is
                      the excluded config/ package, so it legitimately has nothing to measure.
                    -->
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <!--
                          Lombok-generated accessors on the model. Lombok marks them
                          @Generated and JaCoCo skips those natively; this is belt and braces
                          for anything hand-written that sits beside them.
                        -->
                        <exclude>**/model/**</exclude>

                        <!--
                          The composition root. These are @Bean methods that hand one object to
                          another; there is no behaviour to assert that would not just restate
                          the wiring. What proves them is the application starting, which is an
                          integration concern rather than a unit one.

                          Worth being clear about the cost: a mis-wired bean is NOT caught by
                          this build. It is caught the first time the context loads.
                        -->
                        <exclude>**/config/**</exclude>

                        <!--
                          The Spring Boot entry point: a class declaration and a main() that
                          calls SpringApplication.run. "Testing" it means starting the whole
                          application to watch a one-line delegation, and the assertion would be
                          that Spring works.
                        -->
                        <exclude>**/*Application.class</exclude>

                        <exclude>**/package-info.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          README GENERATION
          Run: mvn -P readme package
          Each module writes its own README.md from its package-info.java comments. Documentation
          lives beside the code it describes, is reviewed in the same diff, and cannot drift.
        -->
        <profile>
            <id>readme</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>generate-readme</id>
                                <phase>package</phase>
                                <goals><goal>javadoc</goal></goals>
                                <configuration>
                                    <doclet>com.example.build.readme.ReadmeDoclet</doclet>
                                    <docletArtifact>
                                        <groupId>${project.groupId}</groupId>
                                        <artifactId>readme-doclet</artifactId>
                                        <version>${project.version}</version>
                                    </docletArtifact>
                                    <useStandardDocletOptions>false</useStandardDocletOptions>
                                    <additionalOptions>
                                        <additionalOption>-readmeOutput ${project.basedir}/README.md</additionalOption>
                                        <additionalOption>-readmeTitle "${project.artifactId}"</additionalOption>
                                    </additionalOptions>
                                    <!-- Custom tags must be declared or javadoc rejects them. -->
                                    <tags>
                                        <tag><name>readme.module</name><placement>a</placement><head>Module:</head></tag>
                                        <tag><name>readme.section</name><placement>a</placement><head>Section:</head></tag>
                                        <tag><name>readme.order</name><placement>a</placement><head>Order:</head></tag>
                                        <tag><name>readme.depends</name><placement>a</placement><head>Depends on:</head></tag>
                                    </tags>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
