<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.invoice</groupId>
        <artifactId>invoice-service-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>invoice-service-cache</artifactId>
    <name>Invoice Service :: Caching Adapter</name>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>invoice-service-domain</artifactId>
        </dependency>

        <!--
          The existing referential client. Provided scope: this module compiles against it but the
          invoice service supplies the implementation at runtime.

          NOTE: uncomment and adjust coordinates when adopting into the invoice-service repo, where
          third-parties is a reactor module. Left commented so this repo builds standalone.
        -->
        <!--
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>third-parties</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-no-alerting-dependency</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!--
                                          Every sibling module, banned by pattern rather than by
                                          name. The previous rule listed the two modules that
                                          existed when it was written, which is why a dependency
                                          on a third one was able to appear without objection —
                                          an adapter reaching into the use-case module, backwards
                                          through the hexagon, and nothing said so.

                                          A pattern cannot go stale that way: a module added
                                          tomorrow is banned here the day it exists, and making
                                          it reachable is a deliberate edit to this file.
                                        -->
                                        <exclude>${project.groupId}:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>${project.groupId}:invoice-service-domain</include>
                                    </includes>
                                    <message>
                                        invoice-service-cache is an adapter: it may depend on
                                        invoice-service-domain and on nothing else in this build.
                                        Adapters meet each other at ports in the domain, never by
                                        importing one another. If you need a type from a sibling,
                                        the type belongs in the domain.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
