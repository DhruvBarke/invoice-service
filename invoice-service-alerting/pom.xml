<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.invoice</groupId>
        <artifactId>invoice-service-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>invoice-service-alerting</artifactId>
    <name>Invoice Service :: Alerting Adapter</name>

    <dependencies>
        <!--
          Domain only. Note this module does NOT depend on invoice-service-cache: it implements
          ResponseGuard, a port defined in the domain, so the two adapters never see each other.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>invoice-service-domain</artifactId>
        </dependency>

        <!--
          Registration ports (RegistrationAlertNotifier + RegistrationAlert value types) are
          implemented by RegistrationAlertEmailBridge in this module. Registration itself is a
          pure orchestrator with no compile deps back on us, so this dependency edge stays
          adapter → port and doesn't loop.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>invoice-service-registration</artifactId>
        </dependency>

        <!-- JDBC only; the DataSource is supplied by the application. -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>2.1.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <!--
          TEST SCOPE ONLY. JdbcQuarantineStore is plain JDBC with hand-written SQL, so the only
          test worth having runs it against a real database rather than a mocked Connection —
          a mock would assert that we call the methods we call, which proves nothing about the
          SQL. H2 in PostgreSQL mode runs the production DDL unmodified.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              COVERAGE FLOOR — the one module that does not reach 100%.

              Every other module is held to 1.00/1.00 by the parent. The uncovered constructs
              here are all guards against states that cannot be produced without lying to the
              code, and each is worth keeping:

              EmailAlertPublisher (16 lines, 3 branches)
                The catch blocks wrapping flush() inside the scheduled task, and the
                InterruptedException arms. An exception escaping a ScheduledExecutorService
                task silently cancels every future run — so these catches are the difference
                between "one digest failed" and "alerting stopped and nobody noticed". flush()
                has no throwing path today, which is precisely why they are unreachable; the
                day someone adds one, they are what keeps the scheduler alive. Deleting them to
                win a coverage point would trade a real safeguard for a number.

              JdbcQuarantineStore (3 branches)
                A successful INSERT ... RETURN_GENERATED_KEYS with no key returned; a row
                absent from a SELECT ... WHERE id = ? issued inside the same transaction that
                just updated it; and the outer SQLException arm around connection acquisition.
                Reaching them needs a mock driver that violates the JDBC contract, which would
                assert something about the mock rather than about our SQL. The store IS tested
                against a real H2 running the production DDL — see JdbcQuarantineStoreTest.

              QuarantineService (1 branch)
                markNotified's row == null arm. Unreachable: the statement after the call
                dereferences the same reference, so a null there would already have thrown.

              The floor sits just under the current ratio, so genuinely untested new code still
              fails the build. Raise it back toward 1.00 as these shrink; do not lower it.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.97</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.96</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-no-cache-dependency</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>${project.groupId}:invoice-service-cache</exclude>
                                    </excludes>
                                    <message>
                                        Alerting must not depend on the cache. Both are adapters and
                                        meet only at ResponseGuard, a port in the domain. An adapter
                                        depending on another adapter's module is backwards.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
