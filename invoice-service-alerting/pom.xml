<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.invoice</groupId>
        <artifactId>invoice-service-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>invoice-service-alerting</artifactId>
    <name>Invoice Service :: Alerting Adapter</name>

    <dependencies>
        <!--
          Domain only. Note this module does NOT depend on invoice-service-cache: it implements
          ResponseGuard, a port defined in the domain, so the two adapters never see each other.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>invoice-service-domain</artifactId>
        </dependency>

        <!--
          Registration ports (RegistrationAlertNotifier + RegistrationAlert value types) are
          implemented by RegistrationAlertEmailBridge in this module. Registration itself is a
          pure orchestrator with no compile deps back on us, so this dependency edge stays
          adapter → port and doesn't loop.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>invoice-service-registration</artifactId>
        </dependency>

        <!-- JDBC only; the DataSource is supplied by the application. -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>2.1.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-no-cache-dependency</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>${project.groupId}:invoice-service-cache</exclude>
                                    </excludes>
                                    <message>
                                        Alerting must not depend on the cache. Both are adapters and
                                        meet only at ResponseGuard, a port in the domain. An adapter
                                        depending on another adapter's module is backwards.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
