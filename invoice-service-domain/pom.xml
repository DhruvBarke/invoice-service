<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.invoice</groupId>
        <artifactId>invoice-service-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>invoice-service-domain</artifactId>
    <name>Invoice Service :: Domain</name>

    <dependencies>
        <!--
          NOTHING WITH A RUNTIME OF ITS OWN.
          This is the hexagon: the invoice + party model, the ports, the rules and the
          registration use case. Every other module compiles against this one and nothing else,
          so anything added here lands transitively in all of them. A DataSource, a Spring
          context or an HTTP client reaching this pom is what "the modules got tangled again"
          looks like six months later, so the enforcer rule below fails the build instead.

          Lombok is the one exception, and it is not a runtime dependency: it is provided-scope,
          erased at compile time, and generates the accessors on the ~104 model classes. Writing
          them by hand would be ~8k lines of boilerplate for no gain in independence.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-zero-dependencies</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes><exclude>*:*</exclude></excludes>
                                    <includes>
                                        <!--
                                          Provided scope only, and named explicitly rather than
                                          allowing org.projectlombok:* at any scope: Lombok is
                                          erased at compile time so it reaches no consumer, but
                                          the same coordinates at compile scope WOULD ship, and
                                          the distinction is the entire point of the exception.
                                        -->
                                        <include>org.projectlombok:lombok:*:*:provided</include>
                                        <include>org.junit.jupiter:*:*:*:test</include>
                                        <include>org.junit.platform:*:*:*:test</include>
                                        <include>org.opentest4j:*:*:*:test</include>
                                        <include>org.apiguardian:*:*:*:test</include>
                                    </includes>
                                    <message>
                                        invoice-service-domain must have NO compile or runtime
                                        dependencies. Every other module compiles against this one
                                        alone, so anything added here leaks into all of them and
                                        destroys their independence. Lombok is permitted at
                                        provided scope only; it is erased at compile time.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
