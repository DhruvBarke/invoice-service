package com.example.invoice.config;

import com.example.invoice.service.alerting.AlertingSwitches;
import com.example.invoice.service.domain.rule.AnomalyType;
import org.springframework.web.bind.annotation.*;

/**
 * Runtime control over alert email.
 *
 * <p><b>THIS FILE IS A TEMPLATE</b> ({@code .java.template}) because it needs spring-boot-starter-web,
 * which this module does not pull in. Rename to {@code .java} and add the web starter if you want it.
 *
 * <p><b>Secure this endpoint.</b> It changes production alerting behaviour. Behind your existing
 * admin authentication, not open.
 *
 * <p><b>What it does not do.</b> Nothing here can disable blocking. Muting email leaves every defect
 * detected, recorded and — where blocking — still withheld from invoice registration. If invoices are
 * being rejected and you mute the mail, they will keep being rejected; that is intended. The only
 * break-glass for blocking is {@code invoice.service.alerting.enabled=false}, which is a config
 * change and a deliberate, reviewable act.
 */
@RestController
@RequestMapping("/admin/party-alerting")
public class AlertingAdminController {

    private final AlertingSwitches switches;

    public AlertingAdminController(AlertingSwitches switches) {
        this.switches = switches;
    }

    /** Silences email. Detection, recording and blocking continue — see the class notes. */
    @PostMapping("/email/disable")
    public String disableEmail() {
        switches.setEmailEnabled(false);
        return switches.toString();
    }

    @PostMapping("/email/enable")
    public String enableEmail() {
        switches.setEmailEnabled(true);
        return switches.toString();
    }

    /** Mute one defect type — e.g. a missing SIRET that is expected during a migration. */
    @PostMapping("/mute/{anomaly}")
    public String mute(@PathVariable AnomalyType anomaly) {
        switches.muteAnomaly(anomaly);
        return switches.toString();
    }

    @PostMapping("/unmute/{anomaly}")
    public String unmute(@PathVariable AnomalyType anomaly) {
        switches.unmuteAnomaly(anomaly);
        return switches.toString();
    }

    @GetMapping
    public String state() {
        return switches.toString();
    }
}
