<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.invoice</groupId>
        <artifactId>invoice-service-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>invoice-mapper</artifactId>
    <name>Invoice :: Facade Mappers</name>

    <dependencies>
        <!-- The ONLY invoice-service dependency permitted here. See the enforcer rule below. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>invoice-service-domain</artifactId>
        </dependency>
        <!--
          Lombok: compile-time only. Provided scope means it does NOT propagate to consumers, so
          invoice-mapper's public API is still plain Java classes with hand-written accessors as
          far as the classpath is concerned. Vendored payload types (InvoicePayable, ReportModel,
          UBL Invoice) use @Data/@Builder/@NoArgsConstructor/@AllArgsConstructor because
          hand-rolling ~200 getters/setters/builders across ~100 classes would be pure toil with
          no upside. The maven-enforcer rule below does NOT ban Lombok (unlike Spring / SQL /
          the cache module) precisely because it is compile-time only.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-referential-independence</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!--
                                          Every sibling module, banned by pattern rather than by
                                          name. The previous rule listed the two modules that
                                          existed when it was written, which is why a dependency
                                          on a third one was able to appear without objection —
                                          an adapter reaching into the use-case module, backwards
                                          through the hexagon, and nothing said so.

                                          A pattern cannot go stale that way: a module added
                                          tomorrow is banned here the day it exists, and making
                                          it reachable is a deliberate edit to this file.
                                        -->
                                        <exclude>${project.groupId}:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>${project.groupId}:invoice-service-domain</include>
                                    </includes>
                                    <message>
                                        invoice-mapper is an adapter: it may depend on
                                        invoice-service-domain and on nothing else in this build.
                                        Adapters meet each other at ports in the domain, never by
                                        importing one another. If you need a type from a sibling,
                                        the type belongs in the domain.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
