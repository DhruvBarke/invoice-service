<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sg</groupId>
        <artifactId>invoice-service-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>caching-adapter</artifactId>
    <name>Invoice Service :: Caching Adapter</name>
    <description>The in-memory referential cache behind the party-registration lookup port.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>domain-interface</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-module-boundary</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!--
                                          Sibling modules banned by pattern, not by name. An
                                          earlier version of this rule listed the modules that
                                          existed when it was written, which is exactly how a
                                          dependency on a later one appeared without objection.
                                          A pattern cannot go stale that way.
                                        -->
                                        <exclude>${project.groupId}:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>${project.groupId}:domain-interface</include>
                                    </includes>
                                    <message>
                                        caching-adapter implements PartyRegistrationLookup over
                                        an in-memory cache and may depend on domain-interface
                                        only. It sits BESIDE the referential client rather than
                                        above it — both answer the same port, and a dependency
                                        on third-parties here would make the cache impossible
                                        to exercise without one.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
