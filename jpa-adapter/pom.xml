<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sg</groupId>
        <artifactId>invoice-service-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>jpa-adapter</artifactId>
    <name>Invoice Service :: JPA Adapter</name>
    <description>Entities and the adapters implementing the repository ports over JDBC.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>domain-interface</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-module-boundary</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!--
                                          Sibling modules banned by pattern, not by name. An
                                          earlier version of this rule listed the modules that
                                          existed when it was written, which is exactly how a
                                          dependency on a later one appeared without objection.
                                          A pattern cannot go stale that way.
                                        -->
                                        <exclude>${project.groupId}:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>${project.groupId}:domain-interface</include>
                                    </includes>
                                    <message>
                                        jpa-adapter implements repository ports and may depend
                                        on domain-interface only. Never on domain: the arrow runs
                                        from the adapter to the port it implements, not back into
                                        the service that uses it.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              ONE BRANCH SHORT OF 100%, AND IT IS NOT A REAL PATH.

              JdbcQuarantineStore.upsert opens its Connection with try-with-resources. javac
              desugars that into a null check on the resource plus suppressed-exception
              plumbing, and JaCoCo counts the synthetic arms as branches. Both real paths ARE
              covered — the body throwing, and close() itself throwing after a successful commit
              — which leaves an arm that no input can reach because the resource expression
              cannot return null.

              The alternatives were rewriting a correct try-with-resources as an explicit
              try/finally to satisfy the counter, or excluding the class outright. Reshaping
              working code to please a tool is the worse trade, and excluding it would hide the
              155 lines that ARE meaningfully covered. So: LINE stays at 1.00 and BRANCH sits
              one branch below, which is a number that goes back up if the desugaring changes.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.99</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
