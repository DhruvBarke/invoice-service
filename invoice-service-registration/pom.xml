<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.invoice</groupId>
        <artifactId>invoice-service-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>invoice-service-registration</artifactId>
    <name>Invoice Service :: Registration Pipeline</name>

    <!--
      Orchestrates the e-invoice → InvoicePayable registration flow: map, validate against a
      business-scoped rule set, decide invoice status + lifecycle event (REFUSED / SUSPENDED /
      none), then hand off to persistence + alerting via secondary ports.

      Only two compile deps: invoice-service-domain (for PartyRegistrationLookup) and
      invoice-mapper (for the mapping graph + payable/UBL types). No Spring, no JDBC, no third-
      parties — same referential-independence contract as invoice-mapper, enforced below.
    -->

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>invoice-service-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>invoice-mapper</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-registration-independence</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!--
                                          Registration orchestrates via ports. It must be
                                          constructible from four in-memory stubs (lookup,
                                          existingInvoiceLookup, lifecyclePublisher, alertNotifier)
                                          so its rules can be unit-tested without Spring, a
                                          DataSource, an SMTP endpoint, or a live referential.
                                        -->
                                        <exclude>${project.groupId}:invoice-service-cache</exclude>
                                        <exclude>${project.groupId}:invoice-service-alerting</exclude>
                                        <exclude>${project.groupId}:third-parties</exclude>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.boot:*</exclude>
                                        <exclude>javax.sql:*</exclude>
                                    </excludes>
                                    <message>
                                        invoice-service-registration must depend on
                                        invoice-service-domain + invoice-mapper only. Adapters
                                        (SQL, HTTP, mail) belong in the app module, wired via
                                        the ports this module declares.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
